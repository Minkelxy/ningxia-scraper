{
  "name": "ningxia-scraper",
  "version": "0.1.0",
  "description": "宁夏旅游多平台公开内容素材库 - 合规可追溯的 UGC 采集与标准化链路（小红书 / 微博 / 携程等）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ingest:one": "tsx scripts/ingest-one.ts",
    "ingest:batch": "tsx scripts/ingest-batch.ts",
    "validate:data": "tsx scripts/validate-dataset.ts",
    "dedupe": "tsx scripts/dedupe.ts",
    "export:topics": "tsx scripts/export-topics.ts",
    "content:kit": "tsx scripts/xhs-to-content-kit.ts",
    "mark:removed": "tsx scripts/mark-removed.ts",
    "list:top": "python3 scripts/list-top.py",
    "publish:notes": "tsx scripts/publish-notes.ts",
    "crawl:github": "tsx scripts/crawl-github-journal.ts",
    "crawl:wikipedia": "tsx scripts/crawl-wikipedia.ts",
    "seed": "tsx scripts/seed-data.ts",
    "check": "tsc -b --noEmit",
    "lint": "eslint scripts/ src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high",
    "ci:local": "npm run audit && npm run check && npm run lint && npm run test && npm run validate:data",
    "release:bump": "npm version --no-git-tag-version",
    "release:preflight": "npm run ci:local && npx tsx scripts/export-topics.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "crypto-js": "^4.2.0",
    "csv-stringify": "^6.5.2",
    "csv-parse": "^5.6.0",
    "sharp": "^0.35.3",
    "simhash-js": "^1.0.0",
    "yaml": "^2.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "nock": "^14.0.0",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  }
}
